# Dictionary of XPath 3.1 tokens for the xp3parse fuzz target.
# The format is libFuzzer's: name="value".

# Axes
axis_ancestor="ancestor::"
axis_ancestor_or_self="ancestor-or-self::"
axis_attribute="attribute::"
axis_attribute_abbrev="@"
axis_child="child::"
axis_descendant="descendant::"
axis_descendant_or_self="descendant-or-self::"
axis_following="following::"
axis_following_sibling="following-sibling::"
axis_namespace="namespace::"
axis_parent="parent::"
axis_parent_abbrev=".."
axis_preceding="preceding::"
axis_preceding_sibling="preceding-sibling::"
axis_self="self::"

# Kind tests
kind_any="node()"
kind_attribute="attribute(a, xs:string)"
kind_comment="comment()"
kind_document="document-node(element(a))"
kind_element="element(*, xs:string?)"
kind_namespace_node="namespace-node()"
kind_pi="processing-instruction('t')"
kind_schema_attribute="schema-attribute(a)"
kind_schema_element="schema-element(a)"
kind_text="text()"

# Names and wildcards
name_ncname="local"
name_qname="p:local"
name_eqname="Q{urn:x}local"
name_star="*"
name_star_prefix="p:*"
name_star_local="*:local"
name_star_eqname="Q{urn:x}*"
var_ref="$var"

# Literals
lit_integer="42"
lit_decimal="1.5"
lit_double="1.5e-2"
lit_string_apos="'it''s'"
lit_string_quot="\"a\"\"b\""

# Control
kw_for="for $x in "
kw_let="let $x := "
kw_some="some $x in "
kw_every="every $x in "
kw_return=" return "
kw_satisfies=" satisfies "
kw_if="if ("
kw_then=") then "
kw_else=" else "

# Operators
op_or=" or "
op_and=" and "
op_eq=" = "
op_ne=" != "
op_lt=" < "
op_le=" <= "
op_gt=" > "
op_ge=" >= "
op_val_eq=" eq "
op_val_ne=" ne "
op_val_lt=" lt "
op_val_le=" le "
op_val_gt=" gt "
op_val_ge=" ge "
op_is=" is "
op_precedes=" << "
op_follows=" >> "
op_concat=" || "
op_to=" to "
op_plus=" + "
op_minus=" - "
op_mul=" * "
op_div=" div "
op_idiv=" idiv "
op_mod=" mod "
op_union=" union "
op_pipe=" | "
op_intersect=" intersect "
op_except=" except "
op_simple_map=" ! "
op_arrow=" => "
op_slash="/"
op_slashslash="//"

# Types
type_instance=" instance of "
type_treat=" treat as "
type_castable=" castable as "
type_cast=" cast as "
type_atomic="xs:integer"
type_item="item()"
type_empty="empty-sequence()"
type_function="function(*)"
type_function_typed="function(xs:int) as item()*"
type_map="map(*)"
type_map_typed="map(xs:string, item()*)"
type_array="array(*)"
occurrence_optional="?"
occurrence_star="*"
occurrence_plus="+"

# Functions, maps, arrays and lookups
fn_call="fn:concat('a', 'b')"
fn_ref="fn:concat#2"
fn_inline="function($x as xs:integer) as xs:integer { $x }"
fn_placeholder="f(?, 1)"
map_constructor="map{'k': 1}"
array_square="[1, 2]"
array_curly="array{1, 2}"
lookup_name="?key"
lookup_star="?*"
lookup_integer="?1"
lookup_paren="?($k)"
arrow_call=" => fn:upper-case()"

# Built-in functions with an implementation
func_boolean="boolean("
func_count="count("
func_data="data("
func_empty="empty("
func_error="error("
func_exactly_one="exactly-one("
func_exists="exists("
func_false="false()"
func_head="head("
func_insert_before="insert-before("
func_last="last()"
func_not="not("
func_number="number("
func_one_or_more="one-or-more("
func_position="position()"
func_remove="remove("
func_reverse="reverse("
func_string="string("
func_subsequence="subsequence("
func_tail="tail("
func_true="true()"
func_zero_or_one="zero-or-one("

# Punctuation
punct_lparen="("
punct_rparen=")"
punct_lbracket="["
punct_rbracket="]"
punct_lbrace="{"
punct_rbrace="}"
punct_comma=","
punct_dot="."
punct_dollar="$"
punct_hash="#"
punct_colon=":"
punct_coloncolon="::"
punct_assign=":="
punct_at="@"
punct_bang="!"
punct_question="?"

# Comments and whitespace
comment="(: c :)"
comment_nested="(: a (: b :) :)"
ws_newline="\x0a"
ws_crlf="\x0d\x0a"
ws_tab="\x09"

# Characters the lexer treats specially
char_nul="\x00"
char_invalid="\xff"
char_utf8="gr\xc3\xb6\xc3\x9fe"
