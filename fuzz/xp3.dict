# Dictionary of XPath 3.1 tokens for the xp3parse fuzz target.
# The format is libFuzzer's: name="value".

# Axes
axis_ancestor="ancestor::"
axis_ancestor_or_self="ancestor-or-self::"
axis_attribute="attribute::"
axis_attribute_abbrev="@"
axis_child="child::"
axis_descendant="descendant::"
axis_descendant_or_self="descendant-or-self::"
axis_following="following::"
axis_following_sibling="following-sibling::"
axis_namespace="namespace::"
axis_parent="parent::"
axis_parent_abbrev=".."
axis_preceding="preceding::"
axis_preceding_sibling="preceding-sibling::"
axis_self="self::"

# Kind tests
kind_any="node()"
kind_attribute="attribute(a, xs:string)"
kind_comment="comment()"
kind_document="document-node(element(a))"
kind_element="element(*, xs:string?)"
kind_namespace_node="namespace-node()"
kind_pi="processing-instruction('t')"
kind_schema_attribute="schema-attribute(a)"
kind_schema_element="schema-element(a)"
kind_text="text()"

# Names and wildcards
name_ncname="local"
name_qname="p:local"
name_eqname="Q{urn:x}local"
name_star="*"
name_star_prefix="p:*"
name_star_local="*:local"
name_star_eqname="Q{urn:x}*"
var_ref="$var"

# Literals
lit_integer="42"
lit_decimal="1.5"
lit_double="1.5e-2"
lit_string_apos="'it''s'"
lit_string_quot="\"a\"\"b\""

# Control
kw_for="for $x in "
kw_let="let $x := "
kw_some="some $x in "
kw_every="every $x in "
kw_return=" return "
kw_satisfies=" satisfies "
kw_if="if ("
kw_then=") then "
kw_else=" else "

# Operators
op_or=" or "
op_and=" and "
op_eq=" = "
op_ne=" != "
op_lt=" < "
op_le=" <= "
op_gt=" > "
op_ge=" >= "
op_val_eq=" eq "
op_val_ne=" ne "
op_val_lt=" lt "
op_val_le=" le "
op_val_gt=" gt "
op_val_ge=" ge "
op_is=" is "
op_precedes=" << "
op_follows=" >> "
op_concat=" || "
op_to=" to "
op_plus=" + "
op_minus=" - "
op_mul=" * "
op_div=" div "
op_idiv=" idiv "
op_mod=" mod "
op_union=" union "
op_pipe=" | "
op_intersect=" intersect "
op_except=" except "
op_simple_map=" ! "
op_arrow=" => "
op_slash="/"
op_slashslash="//"

# Types
type_instance=" instance of "
type_treat=" treat as "
type_castable=" castable as "
type_cast=" cast as "
type_atomic="xs:integer"
type_item="item()"
type_empty="empty-sequence()"
type_function="function(*)"
type_function_typed="function(xs:int) as item()*"
type_map="map(*)"
type_map_typed="map(xs:string, item()*)"
type_array="array(*)"
occurrence_optional="?"
occurrence_star="*"
occurrence_plus="+"

# Functions, maps, arrays and lookups
fn_call="fn:concat('a', 'b')"
fn_ref="fn:concat#2"
fn_inline="function($x as xs:integer) as xs:integer { $x }"
fn_placeholder="f(?, 1)"
map_constructor="map{'k': 1}"
array_square="[1, 2]"
array_curly="array{1, 2}"
lookup_name="?key"
lookup_star="?*"
lookup_integer="?1"
lookup_paren="?($k)"
arrow_call=" => fn:upper-case()"

# Built-in functions with an implementation
func_abs="abs("
func_adjust_date_time_to_timezone="adjust-dateTime-to-timezone("
func_adjust_date_to_timezone="adjust-date-to-timezone("
func_adjust_time_to_timezone="adjust-time-to-timezone("
func_avg="avg("
func_base_uri="base-uri("
func_boolean="boolean("
func_ceiling="ceiling("
func_codepoint_equal="codepoint-equal("
func_codepoints_to_string="codepoints-to-string("
func_compare="compare("
func_concat="concat("
func_contains="contains("
func_contains_token="contains-token("
func_count="count("
func_current_date="current-date()"
func_current_date_time="current-dateTime()"
func_current_time="current-time()"
func_data="data("
func_date_time="dateTime("
func_day_from_date="day-from-date("
func_day_from_date_time="day-from-dateTime("
func_days_from_duration="days-from-duration("
func_deep_equal="deep-equal("
func_default_collation="default-collation("
func_distinct_values="distinct-values("
func_document_uri="document-uri("
func_empty="empty("
func_encode_for_uri="encode-for-uri("
func_ends_with="ends-with("
func_error="error("
func_escape_html_uri="escape-html-uri("
func_exactly_one="exactly-one("
func_exists="exists("
func_false="false()"
func_floor="floor("
func_generate_id="generate-id("
func_has_children="has-children("
func_head="head("
func_hours_from_date_time="hours-from-dateTime("
func_hours_from_duration="hours-from-duration("
func_hours_from_time="hours-from-time("
func_implicit_timezone="implicit-timezone()"
func_in_scope_prefixes="in-scope-prefixes("
func_index_of="index-of("
func_innermost="innermost("
func_insert_before="insert-before("
func_iri_to_uri="iri-to-uri("
func_lang="lang("
func_last="last()"
func_local_name="local-name("
func_lower_case="lower-case("
func_math_acos="math:acos("
func_math_asin="math:asin("
func_math_atan="math:atan("
func_math_atan2="math:atan2("
func_math_cos="math:cos("
func_math_exp="math:exp("
func_math_exp10="math:exp10("
func_math_log="math:log("
func_math_log10="math:log10("
func_math_pi="math:pi()"
func_math_pow="math:pow("
func_math_sin="math:sin("
func_math_sqrt="math:sqrt("
func_math_tan="math:tan("
func_matches="matches("
func_max="max("
func_min="min("
func_minutes_from_date_time="minutes-from-dateTime("
func_minutes_from_duration="minutes-from-duration("
func_minutes_from_time="minutes-from-time("
func_month_from_date="month-from-date("
func_month_from_date_time="month-from-dateTime("
func_months_from_duration="months-from-duration("
func_name="name("
func_namespace_uri="namespace-uri("
func_namespace_uri_for_prefix="namespace-uri-for-prefix("
func_node_name="node-name("
func_normalize_space="normalize-space("
func_normalize_unicode="normalize-unicode("
func_not="not("
func_number="number("
func_one_or_more="one-or-more("
func_outermost="outermost("
func_parse_ietf_date="parse-ietf-date("
func_path="path("
func_position="position()"
func_remove="remove("
func_replace="replace("
func_reverse="reverse("
func_root="root("
func_round="round("
func_round_half_to_even="round-half-to-even("
func_seconds_from_date_time="seconds-from-dateTime("
func_seconds_from_duration="seconds-from-duration("
func_seconds_from_time="seconds-from-time("
func_starts_with="starts-with("
func_string="string("
func_string_join="string-join("
func_string_length="string-length("
func_string_to_codepoints="string-to-codepoints("
func_subsequence="subsequence("
func_substring="substring("
func_substring_after="substring-after("
func_substring_before="substring-before("
func_sum="sum("
func_tail="tail("
func_timezone_from_date="timezone-from-date("
func_timezone_from_date_time="timezone-from-dateTime("
func_timezone_from_time="timezone-from-time("
func_tokenize="tokenize("
func_translate="translate("
func_true="true()"
func_upper_case="upper-case("
func_year_from_date="year-from-date("
func_year_from_date_time="year-from-dateTime("
func_years_from_duration="years-from-duration("
func_zero_or_one="zero-or-one("

# Regular expression flags and replacements
regex_flags_i="'i'"
regex_flags_q="'q'"
regex_flags_iq="'iq'"
regex_flags_smx="'smx'"
regex_flags_invalid="'z'"
regex_group="'$1'"
regex_backref="'(.)\\1'"

# Date, time and duration types, and fragments of their lexical forms
type_date_time="xs:dateTime"
type_date_time_stamp="xs:dateTimeStamp"
type_date="xs:date"
type_time="xs:time"
type_g_year_month="xs:gYearMonth"
type_g_year="xs:gYear"
type_g_month_day="xs:gMonthDay"
type_g_day="xs:gDay"
type_g_month="xs:gMonth"
type_duration="xs:duration"
type_year_month_duration="xs:yearMonthDuration"
type_day_time_duration="xs:dayTimeDuration"
type_untyped_atomic="xs:untypedAtomic"
dt_date="'2026-02-28'"
dt_date_time="'2026-01-01T00:00:00'"
dt_time="'23:59:59.999'"
dt_end_of_day="T24:00:00"
dt_fraction=".1234567890"
dt_year_zero="-0000"
dt_year_max="2147483647"
dt_g_month_day="--02-29"
dt_g_day="---31"
dt_tz_utc="Z"
dt_tz_max="+14:00"
dt_tz_min="-14:00"
dt_tz_minus_zero="-00:00"
dur_full="'P1Y2M3DT4H5M6.7S'"
dur_negative="-P"
dur_time="PT"
dur_zero="'PT0S'"
dur_months="P0M"
dur_days="P1D"
dur_huge="PT9223372036854775807S"

# Arithmetic on dates, times and durations
arith_month_end="xs:date('2001-01-31')"
arith_year_month="xs:yearMonthDuration('P1M')"
arith_day_time="xs:dayTimeDuration('PT1S')"
arith_max_months="P768614336404564650Y7M"
arith_inf="xs:double('INF')"
arith_nan="xs:double('NaN')"
arith_tiny="2.6e-9"

# Timezones and the formats of fn:parse-ietf-date
tz_hours="xs:dayTimeDuration('PT14H')"
tz_not_minutes="xs:dayTimeDuration('PT1S')"
ietf_rfc1123="'Wed, 06 Jun 1994 07:29:35 GMT'"
ietf_rfc850="'Sunday, 06-Nov-94 08:49:37 GMT'"
ietf_asctime="'Sun Nov  6 08:49:37 1994'"
ietf_offset=" -0500 (EST)"
ietf_end_of_day=" 24:00 "

# Punctuation
punct_lparen="("
punct_rparen=")"
punct_lbracket="["
punct_rbracket="]"
punct_lbrace="{"
punct_rbrace="}"
punct_comma=","
punct_dot="."
punct_dollar="$"
punct_hash="#"
punct_colon=":"
punct_coloncolon="::"
punct_assign=":="
punct_at="@"
punct_bang="!"
punct_question="?"

# Comments and whitespace
comment="(: c :)"
comment_nested="(: a (: b :) :)"
ws_newline="\x0a"
ws_crlf="\x0d\x0a"
ws_tab="\x09"

# Characters the lexer treats specially
char_nul="\x00"
char_invalid="\xff"
char_utf8="gr\xc3\xb6\xc3\x9fe"
