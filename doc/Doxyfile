# Doxygen configuration, modelled on libxml2's doc/Doxyfile.
# SOURCE_ROOT and BUILD_ROOT are set by the build system and end with "/".
# Set DOXYGEN_WARN_AS_ERROR=FAIL_ON_WARNINGS to make warnings fatal (CI does).

PROJECT_NAME           = libxpath3
PROJECT_BRIEF          = "XPath 3.1 for libxml2 documents"
OUTPUT_DIRECTORY       = $(BUILD_ROOT)doc
STRIP_FROM_PATH        = $(SOURCE_ROOT)include/libxpath3 \
                         $(BUILD_ROOT)include/libxpath3
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = YES
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = YES
SHOW_INCLUDE_FILES     = NO
QUIET                  = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = $(DOXYGEN_WARN_AS_ERROR)
INPUT                  = $(SOURCE_ROOT)doc/mainpage.md \
                         $(SOURCE_ROOT)include/libxpath3/xpath3.h \
                         $(BUILD_ROOT)include/libxpath3/xp3version.h \
                         $(SOURCE_ROOT)xp3ast.c \
                         $(SOURCE_ROOT)xp3chars.c \
                         $(SOURCE_ROOT)xp3context.c \
                         $(SOURCE_ROOT)xp3decimal.c \
                         $(SOURCE_ROOT)xp3double.c \
                         $(SOURCE_ROOT)xp3error.c \
                         $(SOURCE_ROOT)xp3func.c \
                         $(SOURCE_ROOT)xp3lexer.c \
                         $(SOURCE_ROOT)xp3parser.c \
                         $(SOURCE_ROOT)xp3static.c \
                         $(SOURCE_ROOT)xp3types.c \
                         $(SOURCE_ROOT)xp3value.c \
                         $(SOURCE_ROOT)xpath3.c
EXCLUDE_SYMLINKS       = YES
USE_MDFILE_AS_MAINPAGE = $(SOURCE_ROOT)doc/mainpage.md
VERBATIM_HEADERS       = NO
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = NO
ENUM_VALUES_PER_LINE   = 0
GENERATE_LATEX         = NO
GENERATE_XML           = NO
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
INCLUDE_PATH           = $(SOURCE_ROOT)include \
                         $(BUILD_ROOT)include
PREDEFINED             = XP3PUBFUN=
HAVE_DOT               = NO
