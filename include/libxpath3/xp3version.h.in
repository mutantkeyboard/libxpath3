#ifndef XP3_VERSION_H
#define XP3_VERSION_H

/** Version string of the headers, for example "0.0.1". */
#define XP3_VERSION_STRING "@XP3_VERSION@"

/** Major version of the headers. */
#define XP3_VERSION_MAJOR @XP3_VERSION_MAJOR@

/** Minor version of the headers. */
#define XP3_VERSION_MINOR @XP3_VERSION_MINOR@

/** Micro version of the headers. */
#define XP3_VERSION_MICRO @XP3_VERSION_MICRO@

/**
 * Version of the headers as a single number,
 * major * 10000 + minor * 100 + micro. For example 1 for 0.0.1.
 */
#define XP3_VERSION_NUMBER \
    (XP3_VERSION_MAJOR * 10000 + XP3_VERSION_MINOR * 100 + XP3_VERSION_MICRO)

#endif /* XP3_VERSION_H */
